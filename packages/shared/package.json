{
  "name": "@shipyard/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript types, enums, and Zod schemas used by the API and Worker.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "*",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
