{
  "__inputs": [],
  "__elements": {},
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "heatmap", "name": "Heatmap", "version": "" },
    { "type": "panel", "id": "barchart", "name": "Bar chart", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "Deep-dive into the Shipyard deployment pipeline: build durations, health check timings, Traefik verification, and failure stage breakdown.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Build Performance",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-shipyard" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 180 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["mean"] } },
      "title": "Avg Docker Build Duration",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-shipyard" },
          "expr": "sum(rate(shipyard_docker_build_duration_seconds_sum{result=\"success\"}[1h])) / sum(rate(shipyard_docker_build_duration_seconds_count{result=\"success\"}[1h]))",
          "legendFormat": "Avg Build",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-shipyard" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 20 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["mean"] } },
      "title": "Avg Git Checkout Duration",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-shipyard" },
          "expr": "sum(rate(shipyard_git_checkout_duration_seconds_sum{result=\"success\"}[1h])) / sum(rate(shipyard_git_checkout_duration_seconds_count{result=\"success\"}[1h]))",
          "legendFormat": "Avg Checkout",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-shipyard" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 25 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["mean"] } },
      "title": "Avg Container Health Check Duration",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-shipyard" },
          "expr": "sum(rate(shipyard_container_healthcheck_duration_seconds_sum{result=\"success\"}[1h])) / sum(rate(shipyard_container_healthcheck_duration_seconds_count{result=\"success\"}[1h]))",
          "legendFormat": "Avg Health Check",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-shipyard" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 12 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["mean"] } },
      "title": "Avg Traefik Verification Duration",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-shipyard" },
          "expr": "sum(rate(shipyard_traefik_verification_duration_seconds_sum{result=\"success\"}[1h])) / sum(rate(shipyard_traefik_verification_duration_seconds_count{result=\"success\"}[1h]))",
          "legendFormat": "Avg Traefik Verify",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-shipyard" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 5 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 5 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Build & Deploy Stage Durations Over Time (P50 / P95)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-shipyard" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(shipyard_docker_build_duration_seconds_bucket{result=\"success\"}[10m])))",
          "legendFormat": "Build p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-shipyard" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(shipyard_docker_build_duration_seconds_bucket{result=\"success\"}[10m])))",
          "legendFormat": "Build p95",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-shipyard" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(shipyard_container_healthcheck_duration_seconds_bucket{result=\"success\"}[10m])))",
          "legendFormat": "Health Check p50",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-shipyard" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(shipyard_container_healthcheck_duration_seconds_bucket{result=\"success\"}[10m])))",
          "legendFormat": "Health Check p95",
          "refId": "D"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-shipyard" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(shipyard_traefik_verification_duration_seconds_bucket{result=\"success\"}[10m])))",
          "legendFormat": "Traefik Verify p50",
          "refId": "E"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-shipyard" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(shipyard_traefik_verification_duration_seconds_bucket{result=\"success\"}[10m])))",
          "legendFormat": "Traefik Verify p95",
          "refId": "F"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 101,
      "title": "Failure Analysis",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-shipyard" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Deployment Failures by Stage (rate/5m)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-shipyard" },
          "expr": "sum by (failure_stage) (increase(shipyard_deployments_failed_total[5m]))",
          "legendFormat": "Stage: {{failure_stage}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-shipyard" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 7,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Build Failures vs. Successes Over Time",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-shipyard" },
          "expr": "sum(increase(shipyard_docker_build_duration_seconds_count{result=\"success\"}[5m]))",
          "legendFormat": "Builds Succeeded",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-shipyard" },
          "expr": "sum(increase(shipyard_docker_build_duration_seconds_count{result=\"failed\"}[5m]))",
          "legendFormat": "Builds Failed",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 102,
      "title": "Node.js Worker Process Health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-shipyard" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 5 },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 8,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Worker Heap Memory Used",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-shipyard" },
          "expr": "shipyard_worker_nodejs_heap_size_used_bytes",
          "legendFormat": "Heap Used",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-shipyard" },
          "expr": "shipyard_worker_nodejs_heap_size_total_bytes",
          "legendFormat": "Heap Total",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-shipyard" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 5 },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 9,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Worker Event Loop Lag",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-shipyard" },
          "expr": "shipyard_worker_nodejs_eventloop_lag_seconds",
          "legendFormat": "Event Loop Lag (s)",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["shipyard", "pipeline"],
  "templating": { "list": [] },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Shipyard — Deployment Pipeline",
  "uid": "shipyard-pipeline",
  "version": 1
}
