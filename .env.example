# =============================================================================
# Shipyard — Local Development Environment Template
# Copy this file to .env and fill in values. NEVER commit .env.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=shipyard
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=shipyard
DATABASE_URL="postgresql://shipyard:changeme_in_production@localhost:5432/shipyard"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── API Service ───────────────────────────────────────────────────────────────
API_PORT=3001
NODE_ENV=development

# ── GitHub OAuth (for Dashboard login) ───────────────────────────────────────
# Create at: https://github.com/settings/applications/new
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# ── GitHub Webhook ────────────────────────────────────────────────────────────
# A random secret you generate and paste into your GitHub webhook settings.
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# ── Session ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
SESSION_SECRET=your_session_secret

# ── Dashboard ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret

# ── Worker ────────────────────────────────────────────────────────────────────
# Path on the host where Traefik dynamic config files are written.
# Must match the volume mount in docker-compose.infra.yml.
TRAEFIK_DYNAMIC_CONFIG_DIR=/etc/shipyard/traefik/dynamic

# ── Build resource limits ─────────────────────────────────────────────────────
BUILD_TIMEOUT_SECONDS=300
BUILD_MEMORY_LIMIT_MB=1024
BUILD_CPU_LIMIT=1.0

# ── Platform domain (used for Traefik routing rules) ──────────────────────────
SHIPYARD_DOMAIN=shipyard.local
