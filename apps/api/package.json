{
  "name": "@shipyard/api",
  "version": "0.1.0",
  "private": true,
  "description": "Shipyard Control Plane — Express HTTP API, webhook handler, BullMQ producer, SSE log streaming.",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "ts-node --project tsconfig.json src/index.ts",
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "ts-node --project tsconfig.json prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@shipyard/shared": "*",
    "bullmq": "^5.7.0",
    "express": "^4.19.2",
    "ioredis": "^5.3.2",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/supertest": "^7.2.1",
    "prisma": "^5.14.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "*",
    "vitest": "^1.6.0"
  }
}
