# =============================================================================
# Shipyard Terraform Variables Template (terraform.tfvars.example)
#
# Copy this file to terraform.tfvars and customize before running terraform plan:
#   cp terraform.tfvars.example terraform.tfvars
#
# NOTE: Never commit terraform.tfvars if it contains sensitive data.
# =============================================================================

aws_region  = "us-east-1"
environment = "production"
project_name = "shipyard"

# Network
vpc_cidr           = "10.0.0.0/16"
public_subnet_cidr = "10.0.1.0/24"

# Compute (t3.medium: 2 vCPU, 4GB RAM — good baseline for single-host Shipyard)
instance_type       = "t3.medium"
root_volume_size_gb = 50
root_volume_type    = "gp3"

# Access & Security
# SSH is disabled by default (recommended). Port 22 is not opened in the security group
# unless allowed_ssh_cidr is explicitly set. Prefer AWS SSM Session Manager for shell access.
# To enable SSH, uncomment and set to your specific admin IP (never 0.0.0.0/0):
# allowed_ssh_cidr = "203.0.113.4/32"
# ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... admin@laptop"

# Domain & TLS Configuration
domain_name       = "shipyard.yourdomain.com"
letsencrypt_email = "admin@yourdomain.com"
enable_ecr        = true

common_tags = {
  Project   = "Shipyard"
  ManagedBy = "Terraform"
  Owner     = "Krish Gupta"
}
