# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── TypeScript build output ──────────────────────────────────────────────────
dist/
build/
.next/
out/
*.tsbuildinfo

# ─── Environment files ────────────────────────────────────────────────────────
# NEVER commit secrets. Use .env.example for templates.
.env
.env.local
.env.*.local
.env.production
.env.staging

# ─── Logs ────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Test coverage ────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Prisma ───────────────────────────────────────────────────────────────────
# Generated client is re-created by `prisma generate`; do not commit it.
apps/api/node_modules/.prisma/

# ─── Docker volumes (local dev data) ─────────────────────────────────────────
.docker-volumes/

# ─── Terraform ────────────────────────────────────────────────────────────────
# State files and provider plugins contain sensitive data
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/.terraform.lock.hcl
terraform/terraform.tfvars       # contains variable values, possibly secrets

# ─── OS / Editor artefacts ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json
*.swp
*.swo

# ─── Misc ─────────────────────────────────────────────────────────────────────
*.tgz
.turbo/
